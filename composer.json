{
    "name": "laravel/lsp",
    "description": "The Laravel language server.",
    "keywords": [
        "laravel",
        "language-server",
        "lsp",
        "php"
    ],
    "homepage": "https://github.com/laravel/lsp",
    "type": "project",
    "license": "MIT",
    "version": "0.0.18",
    "support": {
        "issues": "https://github.com/laravel/lsp/issues",
        "source": "https://github.com/laravel/lsp"
    },
    "authors": [
        {
            "name": "Laravel"
        }
    ],
    "require": {
        "php": "^8.2.0"
    },
    "require-dev": {
        "illuminate/log": "^11.5",
        "laravel-zero/framework": "^11.0.0",
        "laravel/pint": "^1.15.2",
        "microsoft/tolerant-php-parser": "^0.1.2",
        "mockery/mockery": "^1.6.11",
        "pestphp/pest": "^2.34.7",
        "stillat/blade-parser": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "app/Lsp/Data/Templates/global.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "builds/laravel-lsp"
    ],
    "scripts": {
        "pre-autoload-dump": [
            "test -f fix-class-resolutions.php && php fix-class-resolutions.php || true"
        ]
    }
}
